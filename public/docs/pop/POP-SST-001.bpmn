      <bpmndi:BPMNShape id="Activity_InspecaoPeriodica_di" bpmnElement="Activity_InspecaoPeriodica">
        <dc:Bounds x="980" y="510" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Acidente_di" bpmnElement="Gateway_Acidente" isMarkerVisible="true">
        <dc:Bounds x="1210" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1200" y="497" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistraInspecao_di" bpmnElement="Activity_RegistraInspecao">
        <dc:Bounds x="1310" y="510" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_FimSemIntercorrencia_di" bpmnElement="Event_FimSemIntercorrencia">
        <dc:Bounds x="1520" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1495" y="575" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_PrestaSocorro_di" bpmnElement="Activity_PrestaSocorro">
        <dc:Bounds x="1310" y="650" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistraOcorrencia_di" bpmnElement="Activity_RegistraOcorrencia">
        <dc:Bounds x="1530" y="650" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_InvestigaCausas_di" bpmnElement="Activity_InvestigaCausas">
        <dc:Bounds x="1790" y="650" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DDSExtra_di" bpmnElement="Activity_DDSExtra">
        <dc:Bounds x="2030" y="650" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_FimComAcao_di" bpmnElement="Event_FimComAcao">
        <dc:Bounds x="2250" y="672" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2225" y="715" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_Header_di" bpmnElement="TextAnnotation_Header">
        <dc:Bounds x="900" y="100" width="260" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="266" y="550" />
        <di:waypoint x="320" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="400" y="510" />
