<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ElegibilidadeAtendimento" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_Elegibilidade">
    <bpmn:participant id="Participant_Elegibilidade" name="Elegibilidade e Atendimento — Reativação" processRef="Process_Elegibilidade" />
    <bpmn:textAnnotation id="TextAnnotation_Header">
      <bpmn:text>ELEGIBILIDADE E ATENDIMENTO
Atendimento/Comercial / Setor Técnico
Prestek Telecom
Regras de negócio validadas com o setor (120 dias, equipamentos/débitos, dispensa de visita técnica)
Fluxograma de referência único deste POP (revisão 2026-09-11)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Header" sourceRef="Participant_Elegibilidade" targetRef="TextAnnotation_Header" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Elegibilidade" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Atendimento" name="ATENDIMENTO / COMERCIAL">
        <bpmn:flowNodeRef>StartEvent_Solicitacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarCancelamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Prazo120</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TratarClienteNovo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarEquipamentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarDebitos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Debito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NaoRealizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassificarPreContrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassificarNormal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConferirDocumentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuitarAssinar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VincularEstoque</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EquipOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DispensarVisita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PesquisaSatisfacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Concluido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SetorTecnico" name="SETOR TÉCNICO">
        <bpmn:flowNodeRef>Task_ExecutarVisita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestarSinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestesConformes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrigirConexoes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalizarOSDoc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Solicitacao" name="Cliente solicita reativação">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_VerificarCancelamento" name="Verificar data do cancelamento anterior (aba Cancel./Negat.Desist.)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Prazo120" name="Dentro do prazo de 120 dias?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TratarClienteNovo" name="Tratar como Cliente Novo (Nova Venda)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VerificarEquipamentos" name="Verificar equipamentos na residência (aba Comodato): foto, MAC/série, estado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VerificarDebitos" name="Verificar débitos e multa (aba Financeiro / Financeiro Avulso)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Debito" name="Cliente com débito ou multa?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_NaoRealizado" name="Procedimento não realizado (débito registrado)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ClassificarPreContrato" name="Classificar cliente como pré-contrato">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ClassificarNormal" name="Classificar cliente como normal (Nova Venda)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConferirDocumentos" name="Conferir documentos, telefone e e-mail do cliente">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_QuitarAssinar" name="Quitar 1ª mensalidade e assinar documentos">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VincularEstoque" name="Vincular novos equipamentos no estoque">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_EquipOk" name="Equipamentos em dias, ligados e funcionando?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DispensarVisita" name="Dispensar visita técnica: subir login e liberar acesso">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PesquisaSatisfacao" name="Enviar pesquisa de satisfação">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Concluido" name="Atendimento concluído">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ExecutarVisita" name="Executar visita técnica: instalação/configuração de ONU e roteador">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TestarSinal" name="Testar sinal, velocidade e conectividade">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TestesConformes" name="Testes conformes aos parâmetros?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CorrigirConexoes" name="Corrigir conexões / ajustar equipamentos">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FinalizarOSDoc" name="Finalizar O.S. e documentar: fotos, assinatura do cliente">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Solicitacao" targetRef="Task_VerificarCancelamento" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_VerificarCancelamento" targetRef="Gateway_Prazo120" />
    <bpmn:sequenceFlow id="Flow_3" name="Não" sourceRef="Gateway_Prazo120" targetRef="Task_TratarClienteNovo" />
    <bpmn:sequenceFlow id="Flow_4" name="Sim" sourceRef="Gateway_Prazo120" targetRef="Task_VerificarEquipamentos" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_TratarClienteNovo" targetRef="Task_VerificarEquipamentos" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_VerificarEquipamentos" targetRef="Task_VerificarDebitos" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_VerificarDebitos" targetRef="Gateway_Debito" />
    <bpmn:sequenceFlow id="Flow_8" name="Recusa negociar" sourceRef="Gateway_Debito" targetRef="EndEvent_NaoRealizado" />
    <bpmn:sequenceFlow id="Flow_9" name="Negocia e quita" sourceRef="Gateway_Debito" targetRef="Task_ClassificarPreContrato" />
    <bpmn:sequenceFlow id="Flow_10" name="Sem débito" sourceRef="Gateway_Debito" targetRef="Task_ClassificarNormal" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ClassificarPreContrato" targetRef="Task_ConferirDocumentos" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ClassificarNormal" targetRef="Task_ConferirDocumentos" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConferirDocumentos" targetRef="Task_QuitarAssinar" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_QuitarAssinar" targetRef="Task_VincularEstoque" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_VincularEstoque" targetRef="Gateway_EquipOk" />
    <bpmn:sequenceFlow id="Flow_16" name="Sim" sourceRef="Gateway_EquipOk" targetRef="Task_DispensarVisita" />
    <bpmn:sequenceFlow id="Flow_17" name="Não" sourceRef="Gateway_EquipOk" targetRef="Task_ExecutarVisita" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DispensarVisita" targetRef="Task_PesquisaSatisfacao" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ExecutarVisita" targetRef="Task_TestarSinal" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_TestarSinal" targetRef="Gateway_TestesConformes" />
    <bpmn:sequenceFlow id="Flow_21" name="Não" sourceRef="Gateway_TestesConformes" targetRef="Task_CorrigirConexoes" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CorrigirConexoes" targetRef="Task_TestarSinal" />
    <bpmn:sequenceFlow id="Flow_23" name="Sim" sourceRef="Gateway_TestesConformes" targetRef="Task_FinalizarOSDoc" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_FinalizarOSDoc" targetRef="Task_PesquisaSatisfacao" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_PesquisaSatisfacao" targetRef="EndEvent_Concluido" />
  </bpmn:process>

