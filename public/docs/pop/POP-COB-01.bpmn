<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Cobranca" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_Cobranca">
    <bpmn:participant id="Participant_Cobranca" name="PROCESSO DE COBRANÇA" processRef="Process_Cobranca" />
    <bpmn:textAnnotation id="TextAnnotation_Header">
      <bpmn:text>COBRANÇA
Marcio Felix
Prestek Telecom
Criação | 26/01/2026
Última Atualização | 10/09/2026</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Header" sourceRef="Participant_Cobranca" targetRef="TextAnnotation_Header" />
    <bpmn:textAnnotation id="TextAnnotation_Pendente">
      <bpmn:text>[DECISÃO PENDENTE]
Escopo de "Retirada de Fibra/Comodato"
carece de confirmação do setor
responsável (Infraestrutura/Patrimônio).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Pendente" sourceRef="Task_RetiradaFibra" targetRef="TextAnnotation_Pendente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cobranca" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Cobranca" name="Cobrança">
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Automatizada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receptivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Receptivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AberturaAtiva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegociacaoAtiva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Regularizou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Regularizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditoriaExterna</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Campo" name="Infraestrutura/Campo">
        <bpmn:flowNodeRef>Task_VisitaExterna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CasaAberta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetornoReagendamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegociaCampo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcordoInadimplencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AcordoExterno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetiradaFibra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProcedimentoOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RetiradaDevolucao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelamento</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Inicio" name="Fatura Vencida">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Automatizada" name="Cobrança Automatizada (lembretes multicanal + IA a partir do 6º dia)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Receptivo" name="Atendimento Receptivo (plataforma Synapz)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Receptivo" name="Atendimento Receptivo Concluído">
      <bpmn:incoming>Flow_R2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_AberturaAtiva" name="CRM Cobrança abre O.S. de Cobrança Interna Ativa">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegociacaoAtiva" name="Operador negocia com o cliente (SLA de 48h)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Regularizou" name="Cliente regularizou o débito?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Regularizado" name="Débito Regularizado">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_AuditoriaExterna" name="Auditoria financeira + gera O.S. Lembrete de Cobrança Externa">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_VisitaExterna" name="Cobrador realiza visita domiciliar (Cobrança Externa 30/60 dias)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CasaAberta" name="Casa está aberta?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RetornoReagendamento" name="Encaminha O.S. para &quot;Retorno para Cobrança Externa&quot; (reagendar visita)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegociaCampo" name="Negocia débito / recebe pagamento em campo">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AcordoInadimplencia" name="Houve acordo ou pagamento?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_AcordoExterno" name="Acordo Sim por Cobrança Externa">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_RetiradaFibra" name="[DECISÃO PENDENTE] Retirada de Fibra/Comodato em Campo (checklist fotográfico obrigatório)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ProcedimentoOk" name="Procedimento concluído com sucesso?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_RetiradaDevolucao" name="Retirada de Devolução">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Cancelamento" name="Cancelamento por Inatividade">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Inicio" targetRef="Task_Automatizada" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Automatizada" targetRef="Task_AberturaAtiva" />
    <bpmn:sequenceFlow id="Flow_3" name="Contato espontâneo do cliente" sourceRef="Task_Automatizada" targetRef="Task_Receptivo" />
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_Receptivo" targetRef="EndEvent_Receptivo" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AberturaAtiva" targetRef="Task_NegociacaoAtiva" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NegociacaoAtiva" targetRef="Gateway_Regularizou" />
    <bpmn:sequenceFlow id="Flow_6" name="Sim" sourceRef="Gateway_Regularizou" targetRef="EndEvent_Regularizado" />
    <bpmn:sequenceFlow id="Flow_7" name="Não" sourceRef="Gateway_Regularizou" targetRef="Task_AuditoriaExterna" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AuditoriaExterna" targetRef="Task_VisitaExterna" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_VisitaExterna" targetRef="Gateway_CasaAberta" />
    <bpmn:sequenceFlow id="Flow_10" name="Não (1ª/2ª tentativa)" sourceRef="Gateway_CasaAberta" targetRef="Task_RetornoReagendamento" />
    <bpmn:sequenceFlow id="Flow_11" name="Nova visita agendada" sourceRef="Task_RetornoReagendamento" targetRef="Task_VisitaExterna" />
    <bpmn:sequenceFlow id="Flow_12" name="Sim" sourceRef="Gateway_CasaAberta" targetRef="Task_NegociaCampo" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_NegociaCampo" targetRef="Gateway_AcordoInadimplencia" />
    <bpmn:sequenceFlow id="Flow_14" name="Acordo/Pagamento" sourceRef="Gateway_AcordoInadimplencia" targetRef="EndEvent_AcordoExterno" />
    <bpmn:sequenceFlow id="Flow_15" name="Sem acordo / inadimplência confirmada" sourceRef="Gateway_AcordoInadimplencia" targetRef="Task_RetiradaFibra" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RetiradaFibra" targetRef="Gateway_ProcedimentoOk" />
    <bpmn:sequenceFlow id="Flow_17" name="Sucesso" sourceRef="Gateway_ProcedimentoOk" targetRef="EndEvent_RetiradaDevolucao" />
    <bpmn:sequenceFlow id="Flow_18" name="2ª tentativa sem sucesso" sourceRef="Gateway_ProcedimentoOk" targetRef="EndEvent_Cancelamento" />
  </bpmn:process>

