<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_InternetLenta" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_InternetLenta">
    <bpmn:participant id="Participant_InternetLenta" name="SUPORTE INTERNET LENTA" processRef="Process_InternetLenta" />
    <bpmn:textAnnotation id="TextAnnotation_Header">
      <bpmn:text>POP-INTLE-01 - INTERNET LENTA
Marcio Eduardo Felix
Prestek Telecom
Revisao 004 | 10/09/2026
Gateway "E reincidencia?" destacado (NOC)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Header" sourceRef="Participant_InternetLenta" targetRef="TextAnnotation_Header" />
  </bpmn:collaboration>
  <bpmn:process id="Process_InternetLenta" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_SAC" name="SAC / ATENDIMENTO">
        <bpmn:flowNodeRef>StartEvent_Cliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identificacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DiagnosticoInicial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResolvidoSAC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ResolvidoSAC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbreOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContatoCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SemContato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PesquisaSatisfacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClienteConfirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fidelizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbreReincidencia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NOC" name="NOC">
        <bpmn:flowNodeRef>Task_TriagemOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reincidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidaHistorico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DiagnosticoTecnico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResolveRemoto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AjustesRemotos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EncaminhaTecnico</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tecnico" name="TÉCNICO DE CAMPO">
        <bpmn:flowNodeRef>Task_Preparacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DiagnosticoCampo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FalhaCampo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcoesCorretivas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidacaoDocFoto</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Cliente" name="Cliente relata lentidão / degradação">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Identificacao" name="Identificação do cliente e verificações sistêmicas (SAC)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DiagnosticoInicial" name="Diagnóstico inicial e reinício orientado dos equipamentos">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ResolvidoSAC" name="Resolvido no SAC?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ResolvidoSAC" name="Encerrado no SAC (sem O.S.)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_AbreOS" name="Abre O.S. Internet Lenta">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TriagemOS" name="Triagem inicial da O.S. (NOC) — inclui checagem de reincidência">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Reincidencia" name="É reincidência?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ValidaHistorico" name="Valida histórico e O.S. anterior (reincidência)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DiagnosticoTecnico" name="Diagnóstico técnico: roteador + ONU (Etapas 2 e 3)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ResolveRemoto" name="Resolúvel remotamente e sinais no padrão?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AjustesRemotos" name="Executa ajustes remotos e valida com o cliente">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EncaminhaTecnico" name="Encaminha para Técnico de Campo com diagnóstico">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Preparacao" name="Preparação, deslocamento e abordagem ao cliente (script padrão)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DiagnosticoCampo" name="Diagnóstico físico/lógico e testes de conectividade/Wi-Fi">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_FalhaCampo" name="Falha identificada?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AcoesCorretivas" name="Ações corretivas (troca de equipamento, recrimpagem, site survey)">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ValidacaoDocFoto" name="Validação, documentação fotográfica obrigatória e encerramento em campo">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Feedback" name="Contato ativo para pesquisa de satisfação (até 3 tentativas)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ContatoCliente" name="Contato realizado em até 3 tentativas?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_SemContato" name="Encerrado — falta de contato com o cliente">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_PesquisaSatisfacao" name="Pesquisa e registro da nota de avaliação">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ClienteConfirma" name="Problema resolvido e nota OK?">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Fidelizado" name="Atendimento finalizado e validado">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_AbreReincidencia" name="Abre O.S. de Reincidência vinculada ao atendimento anterior">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Cliente" targetRef="Task_Identificacao" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Identificacao" targetRef="Task_DiagnosticoInicial" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DiagnosticoInicial" targetRef="Gateway_ResolvidoSAC" />
    <bpmn:sequenceFlow id="Flow_4" name="Sim" sourceRef="Gateway_ResolvidoSAC" targetRef="EndEvent_ResolvidoSAC" />
    <bpmn:sequenceFlow id="Flow_5" name="Não" sourceRef="Gateway_ResolvidoSAC" targetRef="Task_AbreOS" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AbreOS" targetRef="Task_TriagemOS" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_TriagemOS" targetRef="Gateway_Reincidencia" />
    <bpmn:sequenceFlow id="Flow_8" name="Sim" sourceRef="Gateway_Reincidencia" targetRef="Task_ValidaHistorico" />
    <bpmn:sequenceFlow id="Flow_9" name="Não" sourceRef="Gateway_Reincidencia" targetRef="Task_DiagnosticoTecnico" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ValidaHistorico" targetRef="Task_DiagnosticoTecnico" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_DiagnosticoTecnico" targetRef="Gateway_ResolveRemoto" />
    <bpmn:sequenceFlow id="Flow_12" name="Sim" sourceRef="Gateway_ResolveRemoto" targetRef="Task_AjustesRemotos" />
    <bpmn:sequenceFlow id="Flow_13" name="Não" sourceRef="Gateway_ResolveRemoto" targetRef="Task_EncaminhaTecnico" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AjustesRemotos" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_EncaminhaTecnico" targetRef="Task_Preparacao" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Preparacao" targetRef="Task_DiagnosticoCampo" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DiagnosticoCampo" targetRef="Gateway_FalhaCampo" />
    <bpmn:sequenceFlow id="Flow_18" name="Sim" sourceRef="Gateway_FalhaCampo" targetRef="Task_AcoesCorretivas" />
    <bpmn:sequenceFlow id="Flow_19" name="Não" sourceRef="Gateway_FalhaCampo" targetRef="Task_ValidacaoDocFoto" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AcoesCorretivas" targetRef="Task_ValidacaoDocFoto" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ValidacaoDocFoto" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Feedback" targetRef="Gateway_ContatoCliente" />
    <bpmn:sequenceFlow id="Flow_23" name="Não" sourceRef="Gateway_ContatoCliente" targetRef="EndEvent_SemContato" />
    <bpmn:sequenceFlow id="Flow_24" name="Sim" sourceRef="Gateway_ContatoCliente" targetRef="Task_PesquisaSatisfacao" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_PesquisaSatisfacao" targetRef="Gateway_ClienteConfirma" />
    <bpmn:sequenceFlow id="Flow_26" name="Sim" sourceRef="Gateway_ClienteConfirma" targetRef="EndEvent_Fidelizado" />
    <bpmn:sequenceFlow id="Flow_27" name="Não" sourceRef="Gateway_ClienteConfirma" targetRef="Task_AbreReincidencia" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_AbreReincidencia" targetRef="Task_TriagemOS" />
  </bpmn:process>

