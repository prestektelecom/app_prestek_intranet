<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GerarFinanceiro" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_GerarFinanceiro">
    <bpmn:participant id="Participant_GerarFinanceiro" name="GERAR FINANCEIRO" processRef="Process_GerarFinanceiro" />
    <bpmn:textAnnotation id="TextAnnotation_Header">
      <bpmn:text>GERAR FINANCEIRO (POP-GERFIN-01)
Prestek Telecom
Revisão 001 — status: EM REVISÃO
Aprovador oficial: [DECISÃO PENDENTE]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Header" sourceRef="Participant_GerarFinanceiro" targetRef="TextAnnotation_Header" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GerarFinanceiro" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Financeiro" name="FINANCEIRO">
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreencheOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Triagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChecklistCompleto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Devolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Devolvido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidaDados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Lancamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeraFatura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalizaEncaminha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reprova</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reprovado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auditoria" name="AUDITORIA">
        <bpmn:flowNodeRef>Task_RecebeAuditoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConferenciaDocumental</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidacaoLancamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aprova</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Aprovado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Inicio" name="Início: Solicitação de Geração Financeira">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PreencheOS" name="Atendente/Comercial preenche OS &quot;GERAR FINANCEIRO&quot; (cliente, contrato, valor, desconto, anexos)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Triagem" name="Financeiro verifica checklist e anexos da OS">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ChecklistCompleto" name="Checklist completo?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Nao1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sim1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Devolve" name="Devolve OS ao solicitante para correção">
      <bpmn:incoming>Flow_Nao1</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Devolvido" name="OS devolvida para correção">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ValidaDados" name="Valida contrato, autorizações internas e pendências anteriores do cliente">
      <bpmn:incoming>Flow_Sim1</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Lancamento" name="Define tipo de documento (501/502), preenche DOCUMENTO/OBS e gera o lançamento">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GeraFatura" name="Gera fatura, exporta PDF e envia ao cliente (e-mail / Portal do Cliente)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FinalizaEncaminha" name="Finaliza a OS e encaminha automaticamente para a Auditoria">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_RecebeAuditoria" name="Auditoria recebe OS &quot;Aguardando Auditoria&quot; e inicia atendimento">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_ConferenciaDocumental" name="Confere solicitação original x contrato do cliente x anexos/autorizações">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ValidacaoLancamento" name="Valida lançamento gerado: tipo de documento, campos DOCUMENTO/OBS e envio da fatura">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Conforme" name="Conforme?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Sim2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nao2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Aprova" name="Aprova a OS com parecer padrão e finaliza definitivamente">
      <bpmn:incoming>Flow_Sim2</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Aprovado" name="Encerrado — Conforme">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Reprova" name="Registra erro detalhado na OS e reprova para correção do Financeiro">
      <bpmn:incoming>Flow_Nao2</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Reprovado" name="Encerrado — Reprovado (retorna ao Financeiro para correção)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Inicio" targetRef="Task_PreencheOS" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PreencheOS" targetRef="Task_Triagem" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Triagem" targetRef="Gateway_ChecklistCompleto" />
    <bpmn:sequenceFlow id="Flow_Nao1" name="Não" sourceRef="Gateway_ChecklistCompleto" targetRef="Task_Devolve" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Devolve" targetRef="EndEvent_Devolvido" />
    <bpmn:sequenceFlow id="Flow_Sim1" name="Sim" sourceRef="Gateway_ChecklistCompleto" targetRef="Task_ValidaDados" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ValidaDados" targetRef="Task_Lancamento" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Lancamento" targetRef="Task_GeraFatura" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_GeraFatura" targetRef="Task_FinalizaEncaminha" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_FinalizaEncaminha" targetRef="Task_RecebeAuditoria" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_RecebeAuditoria" targetRef="Task_ConferenciaDocumental" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ConferenciaDocumental" targetRef="Task_ValidacaoLancamento" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ValidacaoLancamento" targetRef="Gateway_Conforme" />
    <bpmn:sequenceFlow id="Flow_Sim2" name="Sim" sourceRef="Gateway_Conforme" targetRef="Task_Aprova" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Aprova" targetRef="EndEvent_Aprovado" />
    <bpmn:sequenceFlow id="Flow_Nao2" name="Não" sourceRef="Gateway_Conforme" targetRef="Task_Reprova" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Reprova" targetRef="EndEvent_Reprovado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_GerarFinanceiro">
    <bpmndi:BPMNPlane id="BPMNPlane_GerarFinanceiro" bpmnElement="Collaboration_GerarFinanceiro">
