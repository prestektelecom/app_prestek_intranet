      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="500" y="200" />
        <di:waypoint x="560" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AceiteNao_di" bpmnElement="Flow_AceiteNao">
        <di:waypoint x="610" y="200" />
        <di:waypoint x="660" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="182" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="790" y="200" />
        <di:waypoint x="830" y="200" />
      </bpmndi:BPMNEdge>
